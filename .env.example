# --- LLM Provider ---
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM Generation ---
TEMPERATURE=0
LLM_MAX_TOKENS=1024

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chatbot

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=rag_documents

# --- Document Metadata ---
DOCUMENT_METADATA_PATH=./data/documents.json

# --- OCR (Modal, optional) ---
MODAL_OCR_URL=https://kharadechetan--rag-ocr-service-ocr-api.modal.run
OCR_TEXT_THRESHOLD=100

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Ingestion ---
EMBEDDING_BATCH_SIZE=32
MAX_DOCUMENT_SIZE_MB=100

# --- Retrieval ---
TOP_K=10
MAX_CONTEXT_CHUNKS=5

# --- Reranking ---
ENABLE_RERANKING=false

# --- Server ---
HOST=0.0.0.0
PORT=8000
